# --- copy to .env and fill in; NEVER commit .env ---
# Later-stage services (registry / experiment tracking) — not used by the Stage 1 trial:
POSTGRES_DSN=postgresql://cyberai:changeme@localhost:5432/cyberai
MLFLOW_TRACKING_URI=http://localhost:5000
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_MODEL=Qwen/Qwen3-30B-A3B-Instruct-2507-FP8
LAB_GATEWAY_URL=http://10.10.0.2:8080
WIREGUARD_LAB_IP=10.10.0.2
HF_TOKEN=            # HuggingFace token for model download (optional; passed to containers by name)
# HF_HOME=             # model/cache dir override for scripts/gb10_serve.sh (default: ~/.cache/huggingface)

# --- GB10 trial (docs/RENTAL_START_HERE.md). Normally exported in the shell; listed here
# --- so every knob is discoverable. Machine-specific Docker flags are NOT set by hand:
# --- scripts/rental/docker_runtime_setup.py measures them and writes
# --- artifacts/docker_runtime/docker_env.sh (DOCKER_GPU_MODE, DOCKER_IPC_HOST,
# --- DOCKER_SHM_SIZE, DOCKER_ULIMITS, DOCKER_NETWORK) — `source` that file instead.
# MODEL_PATH=/path/to/models/qwen3-fp8          # pinned FP8 serving snapshot
# EVIDENCE_EXPORT_DIR=/path/to/export           # results copy destination
# RENTAL_STOP_UTC=2026-11-20T18:00:00Z          # your deadline (does not stop billing)
# WORKLOAD_DOMAIN=detection                     # detection (lab-free) | web (needs LAB_SSH_HOST)
# TRAIN_MODE=pilot
# PILOT_DATA=data/platform_pilot.jsonl
# TRAIN_PRECISION=bf16                          # comparison run only; default is qlora_4bit
# SERVE_READY_TIMEOUT_S=1800
# RELEASE_WAIT_S=60
# RELEASE_MARGIN_GB=2.0
# MEASURE_CONTEXTS=8000,16000
# MEASURE_CONCURRENCIES=1,8,32
# MEASURE_REQUEST_TIMEOUT_S=600
